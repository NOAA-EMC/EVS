# Configuration file for EVS (all steps and components)

[RUN]
##############################################################
# WHICH EVS STEPS (PREP, STATS, PLOTS) and COMPONENTS TO RUN
##############################################################
## PREP  = PRODUCES PREPARED FORECAST, ANALYSIS, and OBSERVATION FILES 
## STATS = PRODUCES .STAT FILES FROM PREPARED FILES
## PLOTS = PRODUCES PLOTS OF STATISTICS FROM .STAT FILES
## SET TO YES or NO
##
## EDIT SECTIONS BELOW (WHICH EVS STEPS AND COMPONENTS TO RUN)
RUN_PREP_GLOBAL_DET=YES
RUN_STATS_GLOBAL_DET=NO
RUN_PLOTS_GLOBAL_DET=NO

####################################################
# GENERAL SETTINGS APPLIED TO ALL USE CASES
####################################################
[MACHINE]
name=wcoss2
user=$USER
queue_account=VERF-DEV

[INPUT_OUTPUT]
#DATAROOT:               base output directory
DATAROOT=/lfs/h2/emc/vpppg/noscrub/alicia.bentley/test

[DATES]
#start_initdate:          PREP step start date (initdate), format YYYYMMDD
#end_initdate:            PREP step end date (initdate), format YYYYMMDD
#start_vdate:          STATS/PLOTS step start date (vdate), format YYYYMMDD
#end_vdate:            STATS/PLOTS step end date (vdate), format YYYYMMDD
start_initdate=20260622
end_initdate=20260623
start_vdate=20260601
end_vdate=20260602

[WEB]
#SEND2WEB:    whether or not to send maps to webhost
#webhost:     webhost(rzdm) computer
#webhostid:   webhost(rzdm) user name
#webdir:      directory where to send maps on webhost
SEND2WEB=NO
webhost=emcrzdm.ncep.noaa.gov
webhostid=abentley
webdir=/home/people/emc/www/htdocs/users/verification/global/gfs/alicia
img_quality=low

####################################################
# INDIVIDUAL JOB SETTINGS
####################################################
[GLOBAL_DET]
# PREP
jevs_prep_global_det_atmos=YES
jevs_prep_global_det_wave=NO
# STATS
jevs_stats_global_det_aigfs_atmos_grid2grid=NO
jevs_stats_global_det_aigfs_atmos_grid2obs=NO
jevs_stats_global_det_cfs_atmos_grid2grid=NO
jevs_stats_global_det_cfs_atmos_grid2obs=NO
jevs_stats_global_det_cmc_atmos_grid2grid=NO
jevs_stats_global_det_cmc_atmos_grid2obs=NO
jevs_stats_global_det_cmc_regional_atmos_grid2grid=NO
jevs_stats_global_det_dwd_atmos_grid2grid=NO
jevs_stats_global_det_ecmwf_atmos_grid2grid=NO
jevs_stats_global_det_ecmwf_atmos_grid2obs=NO
jevs_stats_global_det_fnmoc_atmos_grid2grid=NO
jevs_stats_global_det_fnmoc_atmos_grid2obs=NO
jevs_stats_global_det_gfs_atmos_grid2grid=NO
jevs_stats_global_det_gfs_atmos_grid2obs=NO
jevs_stats_global_det_gfs_wave_grid2obs=NO
jevs_stats_global_det_jma_atmos_grid2grid=NO
jevs_stats_global_det_jma_atmos_grid2obs=NO
jevs_stats_global_det_metfra_atmos_grid2grid=NO
jevs_stats_global_det_ukmet_atmos_grid2grid=NO
jevs_stats_global_det_ukmet_atmos_grid2obs=NO
# PLOTS
jevs_plots_global_det_atmos_ai_grid2grid_precip_last90days=NO
jevs_plots_global_det_atmos_ai_grid2grid_pres_levs_last90days=NO
jevs_plots_global_det_atmos_ai_grid2obs_pres_levs_last90days=NO
jevs_plots_global_det_atmos_ai_grid2obs_sfc_last90days=NO
jevs_plots_global_det_atmos_grid2grid_means_last31days=NO
jevs_plots_global_det_atmos_grid2grid_means_last90days=NO
jevs_plots_global_det_atmos_grid2grid_precip_last31days=NO
jevs_plots_global_det_atmos_grid2grid_precip_last90days=NO
jevs_plots_global_det_atmos_grid2grid_pres_levs_last31days=NO
jevs_plots_global_det_atmos_grid2grid_pres_levs_last90days=NO
jevs_plots_global_det_atmos_grid2grid_sea_ice_last31days=NO
jevs_plots_global_det_atmos_grid2grid_sea_ice_last90days=NO
jevs_plots_global_det_atmos_grid2grid_snow_last31days=NO
jevs_plots_global_det_atmos_grid2grid_snow_last90days=NO
jevs_plots_global_det_atmos_grid2grid_sst_last31days=NO
jevs_plots_global_det_atmos_grid2grid_sst_last90days=NO
jevs_plots_global_det_atmos_grid2obs_pres_levs_last31days=NO
jevs_plots_global_det_atmos_grid2obs_pres_levs_last90days=NO
jevs_plots_global_det_atmos_grid2obs_ptype_last31days=NO
jevs_plots_global_det_atmos_grid2obs_ptype_last90days=NO
jevs_plots_global_det_atmos_grid2obs_sfc_last31days=NO
jevs_plots_global_det_atmos_grid2obs_sfc_last90days=NO
jevs_plots_global_det_wave_grid2obs_last31days=NO
jevs_plots_global_det_wave_grid2obs_last90days=NO

