suite evs_nco
  family primary
    edit evs_ver 'v2.0'
    edit PACKAGEHOME '/lfs/h2/emc/global/noscrub/%EMC_USER%/para/packages/evs.%evs_ver%'
    edit NET 'evs'
    edit RUN 'evs'
    edit PROJ 'VERF'
    edit PROJENVIR 'DEV'
    edit MACHINE_SITE 'production'
    edit ENVIR 'prod'
    edit QUEUE 'dev'
    edit QUEUE_ARCH 'dev_transfer'
    edit OUTPUTDIR '/lfs/h2/emc/ptmp/%EMC_USER%/ecflow_evs/para/output/prod/today'
    edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
    family 00
      edit CYC '00'
      task cycle_end
        cron 23:00
      family evs
        edit NET 'evs'
        edit RUN 'evs'
        edit PROJ 'VERF'
        family prep
          edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/prep'
          family aigefs
            task jevs_prep_aigefs_atmos
              trigger :TIME >= 0300 and :TIME < 0900
          endfamily
          family global_ens
            task jevs_prep_global_ens_atmos
              trigger :TIME >= 0300 and :TIME < 0900
            task jevs_prep_global_ens_naefs_atmos
              trigger :TIME >= 0300 and :TIME < 0900
            task jevs_prep_global_ens_headline
              trigger :TIME >= 0600 and :TIME < 1200 and ./jevs_prep_global_ens_atmos == complete and ./jevs_prep_global_ens_naefs_atmos == complete
          endfamily
          family cam
            task jevs_prep_cam_radar_vhr_00
              trigger :TIME >= 0005 and :TIME < 0605
              edit VHR '00'
            task jevs_prep_cam_radar_vhr_01
              trigger :TIME >= 0105 and :TIME < 0705
              edit VHR '01'
            task jevs_prep_cam_radar_vhr_02
              trigger :TIME >= 0205 and :TIME < 0805
              edit VHR '02'
            task jevs_prep_cam_radar_vhr_03
              trigger :TIME >= 0305 and :TIME < 0905
              edit VHR '03'
            task jevs_prep_cam_radar_vhr_04
              trigger :TIME >= 0405 and :TIME < 1005
              edit VHR '04'
            task jevs_prep_cam_radar_vhr_05
              trigger :TIME >= 0505 and :TIME < 1105
              edit VHR '05'
            task jevs_prep_cam_precip_vhr_00
              trigger :TIME >= 0030 and :TIME < 0630
              edit VHR '00'
            task jevs_prep_cam_hrrr_precip_vhr_00
              trigger :TIME >= 0030 and :TIME < 0630
              edit VHR '00'
            task jevs_prep_cam_rrfs_precip_vhr_00
              trigger :TIME >= 0030 and :TIME < 0630 and jevs_prep_cam_hrrr_precip_vhr_00 == complete
              edit VHR '00'
            task jevs_prep_cam_rrfsmem_precip_vhr_00_mem_1
              trigger :TIME >= 0030 and :TIME < 0630 and jevs_prep_cam_rrfs_precip_vhr_00 == complete
              edit VHR '00'
              edit MEM '1'
            task jevs_prep_cam_rrfsmem_precip_vhr_00_mem_2
              trigger :TIME >= 0030 and :TIME < 0630 and jevs_prep_cam_rrfsmem_precip_vhr_00_mem_1 == complete
              edit VHR '00'
              edit MEM '2'
            task jevs_prep_cam_rrfsmem_precip_vhr_00_mem_3
              trigger :TIME >= 0030 and :TIME < 0630 and jevs_prep_cam_rrfsmem_precip_vhr_00_mem_2 == complete
              edit VHR '00'
              edit MEM '3'
            task jevs_prep_cam_rrfsmem_precip_vhr_00_mem_4
              trigger :TIME >= 0030 and :TIME < 0630 and jevs_prep_cam_rrfsmem_precip_vhr_00_mem_3 == complete
              edit VHR '00'
              edit MEM '4'
            task jevs_prep_cam_rrfsmem_precip_vhr_00_mem_5
              trigger :TIME >= 0030 and :TIME < 0630 and jevs_prep_cam_rrfsmem_precip_vhr_00_mem_4 == complete
              edit VHR '00'
              edit MEM '5'
            task jevs_prep_cam_hrrr_severe_vhr_00
              trigger :TIME >= 0000 and :TIME < 0600
              edit VHR '00'
            task jevs_prep_cam_rrfs_severe_vhr_00
              trigger :TIME >= 0000 and :TIME < 0600 and jevs_prep_cam_hrrr_severe_vhr_00 == complete
              edit VHR '00'
            task jevs_prep_cam_rrfsmem_severe_vhr_00_mem_1
              trigger :TIME >= 0000 and :TIME < 0600 and jevs_prep_cam_rrfs_severe_vhr_00 == complete
              edit VHR '00'
              edit MEM '1'
            task jevs_prep_cam_rrfsmem_severe_vhr_00_mem_2
              trigger :TIME >= 0000 and :TIME < 0600 and jevs_prep_cam_rrfsmem_severe_vhr_00_mem_1 == complete
              edit VHR '00'
              edit MEM '2'
            task jevs_prep_cam_rrfsmem_severe_vhr_00_mem_3
              trigger :TIME >= 0000 and :TIME < 0600 and jevs_prep_cam_rrfsmem_severe_vhr_00_mem_2 == complete
              edit VHR '00'
              edit MEM '3'
            task jevs_prep_cam_rrfsmem_severe_vhr_00_mem_4
              trigger :TIME >= 0000 and :TIME < 0600 and jevs_prep_cam_rrfsmem_severe_vhr_00_mem_3 == complete
              edit VHR '00'
              edit MEM '4'
            task jevs_prep_cam_rrfsmem_severe_vhr_00_mem_5
              trigger :TIME >= 0000 and :TIME < 0600 and jevs_prep_cam_rrfsmem_severe_vhr_00_mem_4 == complete
              edit VHR '00'
              edit MEM '5'
            task jevs_prep_cam_refs_severe_vhr_00
              trigger :TIME >= 0020 and :TIME < 0620 and ./jevs_prep_cam_hrrr_severe_vhr_00 == complete and ./jevs_prep_cam_rrfs_severe_vhr_00 == complete and ./jevs_prep_cam_rrfsmem_severe_vhr_00_mem_1 == complete and ./jevs_prep_cam_rrfsmem_severe_vhr_00_mem_2 == complete and ./jevs_prep_cam_rrfsmem_severe_vhr_00_mem_3 == complete and ./jevs_prep_cam_rrfsmem_severe_vhr_00_mem_4 == complete and ./jevs_prep_cam_rrfsmem_severe_vhr_00_mem_5 == complete
              edit VHR '00'
            task jevs_prep_cam_rrfs_chem_grid2obs
              trigger :TIME >= 00:05 and :TIME < 0600
          endfamily
          family aqm
            task jevs_prep_aqm_atmos_grid2obs
              trigger :TIME >= 0500 and :TIME < 1100
            task jevs_prep_aqm_atmos_grid2grid
              trigger :TIME >= 0515 and :TIME < 1115
          endfamily
          family global_chem
            task jevs_prep_global_chem_atmos_grid2obs
